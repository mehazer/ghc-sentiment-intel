# Core
GHC_ENV=dev
GHC_DATABASE_URL=postgresql+psycopg://ghc:ghc_dev_password@localhost:5432/ghc
GHC_REDIS_URL=redis://localhost:6379/0
GHC_CORS_ORIGINS=http://localhost:3000

# Ingestion credentials (leave blank to run in synthetic/manual mode)
GHC_X_BEARER_TOKEN=
GHC_REDDIT_CLIENT_ID=
GHC_REDDIT_CLIENT_SECRET=
GHC_CRYPTOPANIC_TOKEN=
GHC_GLASSNODE_API_KEY=
GHC_WHALE_ALERT_API_KEY=

# Scoring weights (must sum to 1.0)
GHC_W_SENTIMENT=0.30
GHC_W_ATTENTION=0.25
GHC_W_VELOCITY=0.15
GHC_W_SMART_MONEY=0.20
GHC_W_VOLUME=0.10

# GHC thresholds (% from balance line)
GHC_GHC_S1=50
GHC_GHC_S2=100
GHC_GHC_B1=-50
GHC_GHC_B2=-90
GHC_GHC_OUTLIER_PNL_PCT=-3

# Sentiment backend: lexicon | finbert
GHC_SENTIMENT_BACKEND=lexicon
GHC_FINBERT_MODEL=ProsusAI/finbert
